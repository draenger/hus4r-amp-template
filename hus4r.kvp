App.EnvironmentVariables={"HUS4R_BASE":"{{DownloadBase}}","DL_USER":"{{DownloadUser}}","DL_PASSWORD":"{{DownloadPassword}}","HUS4R_PASSWORD":"{{ServerPassword}}","HUS4R_SERVERNAME":"{{ServerName}}","HUS4R_MAXPLAYERS":"{{MaxPlayers}}","HUS4R_PORT":"{{$ServerPort}}","HUS4R_SEED":"{{WorldSeed}}","HUS4R_AUTOSAVE":"{{AutosaveSeconds}}","HUS4R_AUTOUPDATE":"0"}
